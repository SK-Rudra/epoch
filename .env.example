# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# SECRET. Only used by `npm run seed` and `npm run set-password`. Never prefix with NEXT_PUBLIC_, never add to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
