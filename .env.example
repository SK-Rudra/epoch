# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# Where magic links send you back to (your Vercel URL in production)
SITE_URL=http://localhost:3000

# SECRET. Only used by `npm run seed`. Never prefix with NEXT_PUBLIC_, never add to Vercel.
SUPABASE_SERVICE_ROLE_KEY=
