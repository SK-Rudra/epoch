# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in
ALLOWED_EMAIL=

# SECRET, skips RLS. Used by `npm run seed`, `npm run set-password` and the LeetCode cron
# (/api/cron/leetcode, which runs with no signed-in user). Add it to Vercel as a server variable.
# Never prefix with NEXT_PUBLIC_: the build refuses to run if you do.
SUPABASE_SERVICE_ROLE_KEY=

# Your public LeetCode username (the one in leetcode.com/u/<username>)
LEETCODE_USERNAME=

# SECRET. Random string Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>". Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
